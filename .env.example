# Cloudinary — used ONLY by the dev-only upload tool (src/dev/UploadTool.tsx).
#
# These are inlined into the bundle by Vite at build time, which is why the
# upload tool is wrapped in import.meta.env.DEV: in a production build the tool
# and these values are tree-shaken out entirely and never reach a visitor.
#
# The old build shipped VITE_PIN to every visitor as a "gate". It was readable
# in devtools in ten seconds. It has been removed rather than replaced.
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

# In the Cloudinary dashboard, lock this preset down:
#   - restrict to a single folder
#   - set a max file size
#   - allow only image and video formats
